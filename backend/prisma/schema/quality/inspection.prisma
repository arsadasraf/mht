model GateEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  gateEntryNumber        String   @unique
  grnNumber              String   @default("")
  poNumber               String
  projectId              String
  vendorName             String
  challanOrInvoiceNumber String   @default("")
  vehicleNumber          String   @default("")
  itemsCount             Int      @default(1)
  status                 String   @default("QUARANTINE_HOLD") // QUARANTINE_HOLD, QC_CLEARED, REJECTED_AT_GATE
  inwardDate             DateTime @default(now())
  securityGuardName      String   @default("Security Gate")
  notes                  String   @default("")

  // Universal Action Tracking
  createdById            String?  @db.Uuid
  createdByName          String   @default("")
  updatedById            String?  @db.Uuid
  updatedByName          String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([projectId])
  @@index([poNumber])
  @@map("quality_gate_entries")
}

model QcInspection {
  id               String   @id @default(uuid()) @db.Uuid
  inspectionNumber String   @unique
  gateEntryId      String?  @db.Uuid
  grnNumber        String   @default("")
  projectId        String
  poNumber         String
  itemCode         String
  itemName         String
  receivedQty      Json     @default("{}")
  acceptedQty      Json     @default("{}")
  rejectedQty      Json     @default("{}")
  reworkQty        Json     @default("{}")
  overallVerdict   String   @default("ACCEPTED") // ACCEPTED, PARTIALLY_ACCEPTED, REJECTED_RTV, REWORK_REQUIRED
  defects          Json     @default("[]")
  inspectorRemarks String   @default("")
  inspectedAt      DateTime @default(now())

  // Universal Action Tracking
  createdById      String?  @db.Uuid
  createdByName    String   @default("")
  updatedById      String?  @db.Uuid
  updatedByName    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@index([itemCode])
  @@map("quality_inspections")
}

