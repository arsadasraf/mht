model AssemblyStage {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String
  sequenceOrder        Int      @default(1)
  subAssemblyGroup     String
  stageName            String   @default("")
  status               String   @default("PENDING") // PENDING, IN_PROGRESS, GATE_PASSED
  progressPercentage   Int      @default(0)
  technicianAssignedId String?  @db.Uuid
  technicianName       String   @default("")
  gateChecklistPassed  Boolean  @default(false)
  stageGateSignOffById String?  @db.Uuid
  stageGateSignOffName String   @default("")
  stageGateSignOffAt   DateTime?
  notes                String   @default("")

  // Universal Action Tracking
  createdById          String?  @db.Uuid
  createdByName        String   @default("")
  updatedById          String?  @db.Uuid
  updatedByName        String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
  @@map("production_assembly_stages")
}

model MachineTrial {
  id                String   @id @default(uuid()) @db.Uuid
  trialRunNumber    String   @unique
  projectId         String
  trialType         String   @default("DRY_RUN") // DRY_RUN, WET_RUN, PDI_FINAL
  trialDate         DateTime @default(now())
  parametersChecked Json     @default("[]")
  snags             Json     @default("[]")
  trialVerdict      String   @default("PASS_TRIAL_CLEARED") // PASS_TRIAL_CLEARED, FAIL_SNAGS_PENDING
  trialEngineerId   String?  @db.Uuid
  trialEngineerName String   @default("")
  notes             String   @default("")

  // Universal Action Tracking
  createdById       String?  @db.Uuid
  createdByName     String   @default("")
  updatedById       String?  @db.Uuid
  updatedByName     String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@map("production_machine_trials")
}

