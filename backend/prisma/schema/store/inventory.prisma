model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  itemCode         String   @unique
  itemName         String
  category         String   @default("BO") // RM, BO, COMPONENT, SUB_ASSEMBLY, ASSEMBLY, CONSUMABLE
  baseUom          String   @default("Nos")
  alternateUom     String   @default("Nos")
  conversionRatio  Float    @default(1)
  binLocation      String   @default("BIN-GEN-01")
  locationName     String   @default("")
  itemType         String   @default("RM_BO") // RM_BO or DRAWING
  minSafetyStock   Float    @default(0)

  // 4-Bucket Inventory Ledger
  orderedQty       Float    @default(0)
  inQcQty          Float    @default(0)
  acceptedQty      Float    @default(0)
  issuedQty        Float    @default(0)
  reservedQuantity Float    @default(0)

  // Universal Action Tracking
  createdById      String?  @db.Uuid
  createdByName    String   @default("")
  updatedById      String?  @db.Uuid
  updatedByName    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([itemCode])
  @@index([category])
  @@map("store_inventory_items")
}

model GrnRecord {
  id                      String    @id @default(uuid()) @db.Uuid
  grnNumber               String    @unique
  grnType                 String    @default("BO") // RM, BO, COMPONENT, SUB_ASSEMBLY, ASSEMBLY, CONSUMABLE, FG
  poNumber                String    @default("")
  poId                    String?   @db.Uuid
  projectId               String    @default("")
  vendorId                String?   @db.Uuid
  vendorName              String    @default("")
  invoiceNo               String    @default("")
  invoiceDate             DateTime?
  receivedDate            DateTime  @default(now())
  binLocation             String    @default("General Store")
  qcStatus                String    @default("PENDING_IQC") // PENDING_IQC, DIRECT_ACCEPTED, QC_ACCEPTED, QC_REJECTED
  
  // Multi-Line Items (JSON array of line item objects)
  items                   Json      @default("[]")
  
  // Financial & Tax Breakdown
  taxableSubtotal         Float     @default(0)
  totalItemTax            Float     @default(0)
  
  // Transportation & Freight
  transportationCharges   Float     @default(0)
  transportationGstPercent Float    @default(0)
  transportationGstAmount Float     @default(0)
  
  // Packing & Forwarding
  packingCharges          Float     @default(0)
  packingGstPercent       Float     @default(0)
  packingGstAmount        Float     @default(0)
  
  roundOff                Float     @default(0)
  grandTotal              Float     @default(0)
  
  notes                   String    @default("")

  // Universal Action Tracking
  createdById             String?   @db.Uuid
  createdByName           String    @default("")
  updatedById             String?   @db.Uuid
  updatedByName           String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([projectId])
  @@index([poNumber])
  @@index([vendorName])
  @@map("store_grn_records")
}

model StoreMaterialRequest {
  id            String   @id @default(uuid()) @db.Uuid
  mrNumber      String   @unique
  projectId     String
  department    String   @default("PRODUCTION")
  requestedBy   String   @default("")
  status        String   @default("PENDING") // PENDING, ISSUED, PARTIAL
  items         Json     @default("[]")
  notes         String   @default("")

  // Universal Action Tracking
  createdById   String?  @db.Uuid
  createdByName String   @default("")
  updatedById   String?  @db.Uuid
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@map("store_material_requests")
}

model StoreDeliveryChallan {
  id            String   @id @default(uuid()) @db.Uuid
  dcNumber      String   @unique
  dcType        String   @default("RETURNABLE") // RETURNABLE, NON_RETURNABLE
  projectId     String   @default("")
  vendorName    String
  purpose       String   @default("Job Work / Coating")
  status        String   @default("DISPATCHED") // DISPATCHED, RETURNED
  items         Json     @default("[]")
  returnNotes   String   @default("")

  // Universal Action Tracking
  createdById   String?  @db.Uuid
  createdByName String   @default("")
  updatedById   String?  @db.Uuid
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dcNumber])
  @@map("store_delivery_challans")
}

