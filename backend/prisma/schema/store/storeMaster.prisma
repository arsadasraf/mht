model StoreLocationMaster {
  id            String   @id @default(uuid()) @db.Uuid
  binCode       String   @unique
  zoneName      String   @default("Zone A")
  rackNumber    String   @default("R-01")
  shelfLevel    String   @default("L1")
  storageType   String   @default("BO") // RM, BO, COMPONENT, SUB_ASSEMBLY, ASSEMBLY, CONSUMABLE
  capacityInfo  String   @default("500 Kg")
  isActive      Boolean  @default(true)

  // Universal Action Tracking
  createdById   String?  @db.Uuid
  createdByName String   @default("")
  updatedById   String?  @db.Uuid
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([binCode])
  @@map("store_location_masters")
}

model StoreConfig {
  id               String   @id @default(uuid()) @db.Uuid
  configKey        String   @unique @default("GLOBAL_STORE_CONFIG")
  prefixLockPolicy Json     @default("{}")

  // Universal Action Tracking
  createdById      String?  @db.Uuid
  createdByName    String   @default("")
  updatedById      String?  @db.Uuid
  updatedByName    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("store_config")
}

