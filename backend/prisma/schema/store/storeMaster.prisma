model StoreLocationMaster {
  id            String   @id @default(uuid()) @db.Uuid
  locationName  String   @unique
  locationType  String   @default("Rack") // Rack, Bin, Shelf, Bay, Yard, Floor, Cage, Mezzanine, Staging Area, Quarantine Area, Other
  description   String   @default("")
  isActive      Boolean  @default(true)

  // Universal Action Tracking
  createdById   String?  @db.Uuid
  createdByName String   @default("")
  updatedById   String?  @db.Uuid
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([locationName])
  @@index([locationType])
  @@map("store_location_masters")
}

model StoreConfig {
  id               String   @id @default(uuid()) @db.Uuid
  configKey        String   @unique @default("GLOBAL_STORE_CONFIG")
  prefixLockPolicy Json     @default("{}")
  companyProfile   Json     @default("{}")
  timePolicy       Json     @default("{}")

  // Universal Action Tracking
  createdById      String?  @db.Uuid
  createdByName    String   @default("")
  updatedById      String?  @db.Uuid
  updatedByName    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("store_config")
}

