enum OrderAcceptanceStatus {
  DRAFT
  OA_SENT
  OA_ACKNOWLEDGED
}

enum CustomerPoStatus {
  RECEIVED
  OA_ISSUED
  WORK_ORDER_CREATED
  PROJECT_CONVERTED
  IN_PROGRESS
  DISPATCHED
  COMMISSIONED
  CANCELLED
}

enum PoItemQtyType {
  NUMERIC
  EXTRA
  INCLUDED
}

model CustomerPo {
  id                       String                @id @default(uuid()) @db.Uuid
  poNumber                 String                @unique
  poDate                   DateTime
  orderAcceptanceNumber    String?               @unique
  orderAcceptanceDate      DateTime?
  deliveryCommitmentDate   DateTime?

  // Customer & Billing / Shipment Details
  customerId               String?               @db.Uuid
  customer                 Customer?             @relation("CustomerPurchaseOrders", fields: [customerId], references: [id], onDelete: SetNull)
  quotationId              String?
  leadId                   String?

  companyName              String
  customerName             String                @default("")
  contactEmail             String                @default("")
  contactPhone             String                @default("")
  gstin                    String                @default("")
  billingAddress           String                @default("")
  shippingAddress          String                @default("")

  // Relational Line Items (Machines, Parts & "Extra" Accessories)
  items                    CustomerPoItem[]

  // Financials & Package Pricing Mode
  currency                 CustomerCurrency      @default(INR)
  exchangeRate             Float                 @default(1.0)
  isLumpSumTotal           Boolean               @default(false)
  subtotalAmount           Json
  totalTaxAmount           Json
  totalAmount              Json

  // Page 2: Technical Specifications & 11 Terms & Conditions
  technicalSpecifications  String                @default("")
  termsAndConditions       Json

  // Company Bank Details & Authorized Signatory (Machine House Technologies)
  bankDetails              Json
  signatory                Json

  // Optional Attachments & Notes
  s3DocumentKey            String                @default("")
  pdfUrl                   String                @default("")
  photos                   String[]              @default([])
  notes                    String                @default("")
  paymentTerms             String                @default("50% Advance along with purchase order, 50% Before dispatch")

  // Order Acceptance Workflow Status (DRAFT -> OA_SENT -> OA_ACKNOWLEDGED)
  oaStatus                 OrderAcceptanceStatus @default(DRAFT)
  oaSentAt                 DateTime?
  oaSentToEmail            String                @default("")
  oaAcknowledgedAt         DateTime?

  // Project Spine Handover Status
  status                   CustomerPoStatus      @default(RECEIVED)
  convertedProjectId       String?
  convertedAt              DateTime?

  // Mandatory Universal Action Tracking (Who Created & Who Updated Last)
  createdById              String?               @db.Uuid
  createdBy                User?                 @relation("CustomerPoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName            String                @default("")

  updatedById              String?               @db.Uuid
  updatedBy                User?                 @relation("CustomerPoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByName            String                @default("")

  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([poNumber])
  @@index([orderAcceptanceNumber])
  @@index([companyName])
  @@index([status])
  @@index([oaStatus])
  @@map("customer_pos")
}

model CustomerPoItem {
  id             String        @id @default(uuid()) @db.Uuid
  customerPoId   String        @db.Uuid
  customerPo     CustomerPo    @relation(fields: [customerPoId], references: [id], onDelete: Cascade)

  slNo           Int           @default(1)
  itemCode       String        @default("")
  modelCode      String        @default("")
  description    String
  specifications String        @default("")
  hsnCode        String        @default("8479")

  qtyType        PoItemQtyType @default(NUMERIC)
  quantity       Float         @default(1)
  qtyLabel       String        @default("1")
  uom            String        @default("No.")

  unitPrice      Float         @default(0)
  taxRate        Float         @default(18)
  taxAmount      Float         @default(0)
  totalAmount    Float         @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerPoId, slNo])
  @@map("customer_po_items")
}

