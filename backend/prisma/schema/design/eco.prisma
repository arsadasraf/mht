model Eco {
  id                String    @id @default(uuid()) @db.Uuid
  ecoNumber         String    @unique
  projectId         String
  title             String
  reasonForChange   String
  changeType        String    @default("DIMENSIONAL_CHANGE")
  affectedItemCodes String[]  @default([])
  status            String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED_FREEZE, REJECTED
  freezeActionTaken Boolean   @default(false)

  approvedById      String?   @db.Uuid
  approvedByName    String    @default("")
  approvedAt        DateTime?
  approvalNotes     String    @default("")

  // Universal Action Tracking
  createdById       String?   @db.Uuid
  createdByName     String    @default("")
  updatedById       String?   @db.Uuid
  updatedByName     String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId])
  @@index([ecoNumber])
  @@index([status])
  @@map("engineering_change_orders")
}

