model Bom {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @unique
  bomNumber            String   @unique
  revision             String   @default("REV-0")
  attachedAssemblyCode String   @default("")
  attachedAssemblyName String   @default("")
  isFrozen             Boolean  @default(false)

  // Hierarchical BOM Tree Items
  items                Json     @default("[]")

  approvedById         String?  @db.Uuid
  approvedByName       String   @default("")
  approvedAt           DateTime?

  // Universal Action Tracking
  createdById          String?  @db.Uuid
  createdByName        String   @default("")
  updatedById          String?  @db.Uuid
  updatedByName        String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
  @@index([bomNumber])
  @@map("project_boms")
}

